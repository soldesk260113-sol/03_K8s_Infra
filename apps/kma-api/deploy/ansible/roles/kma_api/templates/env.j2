# ===== KMA =====
KMA_AUTHKEY={{ kma_authkey }}

# ===== Database (PostgreSQL) =====
DB_HOST={{ db_host }}
DB_PORT={{ db_port }}
DB_NAME={{ db_name }}
DB_SCHEMA={{ db_schema }}
DB_USER={{ db_user }}
DB_PASSWORD={{ db_password }}
DB_SSLMODE={{ db_sslmode }}

# ===== Redis (Cache) =====
REDIS_HOST={{ redis_host }}
REDIS_PORT={{ redis_port }}
REDIS_PREFIX={{ redis_prefix }}
REDIS_TTL_ULTRA_SECONDS={{ redis_ttl_ultra_seconds }}
REDIS_TTL_SHORT_SECONDS={{ redis_ttl_short_seconds }}

# ===== Timezone =====
TZ={{ tz }}
